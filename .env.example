POSTGRES_USER=user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gophprofile

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

ADDRESS=0.0.0.0:8080
WEB_PATH=./web/static
DATABASE_DSN=postgres://user:changeme@postgres:5432/gophprofile?sslmode=disable

S3_BUCKET_NAME=avatars
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=changeme
S3_USE_SSL=false

KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC=avatar-events
KAFKA_GROUP_ID=avatar-workers-group

MAX_RETRIES=3
WORKER_RETRY_DELAY=500ms